<section class="servicios-section" id="servicios">
  <div class="servicios-container">
    <h2 class="section-title">Servicios</h2>

    <div class="swiper servicios-carousel">
      <div class="swiper-wrapper">
        <!-- Tarjeta 1 -->
        <div class="swiper-slide">
          <div class="servicio-card card-light" tabindex="0">
            <h3 class="card-title">Arquitectura y Construcción</h3>
            <p class="card-desc">
              Construimos tu obra nueva desde la planificación hasta la entrega
              final, garantizando calidad, cumplimiento y eficiencia.
            </p>
            <div class="card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="7" x2="17" y2="17"></line>
                <polyline points="17 7 17 17 7 17"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Tarjeta 2 -->
        <div class="swiper-slide">
          <div class="servicio-card card-dark" tabindex="0">
            <h3 class="card-title">Gestión de Licencias Urbanísticas</h3>
            <p class="card-desc">
              Acompañamos la ejecución de tu obra desde la planificación hasta
              la entrega, asegurando calidad, cumplimiento y eficiencia.
            </p>
            <div class="card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="7" x2="17" y2="17"></line>
                <polyline points="17 7 17 17 7 17"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Tarjeta 3 -->
        <div class="swiper-slide">
          <div class="servicio-card card-light" tabindex="0">
            <h3 class="card-title">
              Estudio Inmobiliario y Viabilidad Jurídica
            </h3>
            <p class="card-desc">
              Analizamos antecedentes registrales y normativos, identificando
              riesgos y oportunidades para el desarrollo de tu inversión.
            </p>
            <div class="card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="7" x2="17" y2="17"></line>
                <polyline points="17 7 17 17 7 17"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Tarjeta 4 -->
        <div class="swiper-slide">
          <div class="servicio-card card-dark" tabindex="0">
            <h3 class="card-title">Reparaciones Locativas</h3>
            <p class="card-desc">
              Renovamos, adecuamos y mejoramos espacios existentes, combinando
              diseño funcional con acabados de alto nivel.
            </p>
            <div class="card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="7" x2="17" y2="17"></line>
                <polyline points="17 7 17 17 7 17"></polyline>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="section-subtitle">
      En Área 94 ofrecemos un enfoque integral que combina diseño, técnica y
      gestión normativa para materializar proyectos sólidos y bien
      estructurados. Nuestro portafolio de servicios está diseñado para
      acompañarte en cada etapa del proceso, con soluciones a la medida de tus
      necesidades.
    </p>
  </div>
</section>

<style>
  .servicios-section {
    padding: 64px 32px;
    background-color: var(--bg);
    display: flex;
    justify-content: center;
  }

  .servicios-container {
    max-width: 1600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section-title {
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 600;
    color: var(--primary);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.5px;
    text-align: center;
  }

  .section-subtitle {
    font-size: 15px;
    line-height: 1.6;
    color: var(--secondary);
    margin: 0 auto;
    max-width: 80%;
    text-align: center;
  }

  /* Carousel / Swiper Tweaks */
  .servicios-carousel {
    width: 100%;
    padding: 16px 4px; /* Padding extra para que el hover no se recorte con el overflow de swiper */
    margin: -16px -4px;
    overflow: hidden;
  }

  .swiper-slide {
    height: auto; /* Para que todas las tarjetas tengan el mismo alto flex */
    display: flex;
  }

  /* Cards */
  .servicio-card {
    border-radius: 24px;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 340px;
    cursor: default;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    outline: none;
  }

  .servicio-card:hover {
    transform: translateY(-8px);
  }

  .card-light:hover {
    box-shadow: 0 16px 32px rgba(35, 39, 47, 0.08);
  }

  .card-dark:hover {
    box-shadow: 0 16px 32px rgba(35, 39, 47, 0.25);
  }

  .card-light {
    background-color: #f2f3f6; /* Soft gray from user rules for light patterns */
    color: var(--primary);
  }

  .card-dark {
    background-color: var(--primary);
    color: var(--accent);
  }

  .card-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 16px 0;
    line-height: 1.3;
    letter-spacing: -0.3px;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .card-light .card-desc {
    color: var(--secondary);
  }

  .card-dark .card-desc {
    color: rgba(255, 255, 255, 0.75);
  }

  .card-icon {
    margin-top: auto;
    align-self: flex-end;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card-light .card-icon {
    background-color: var(--primary);
    color: var(--accent);
  }

  .card-dark .card-icon {
    background-color: var(--accent);
    color: var(--primary);
  }

  .servicio-card:hover .card-icon {
    transform: rotate(-45deg) scale(1.05); /* Efecto creativo de hover que indica acción o visualización */
  }

  /* Responsive Behavior */
  @media (max-width: 1199px) {
    /* Tablet */
    .servicios-section {
      padding: 40px 16px;
    }
    .servicios-container {
      gap: 32px;
    }
    .section-subtitle {
      max-width: 100%;
    }
    .servicio-card {
      padding: 32px 24px;
      min-height: 300px;
    }
    .card-title {
      font-size: 18px;
    }
  }

  @media (max-width: 767px) {
    /* Mobile */
    .servicios-section {
      padding: 24px 16px;
    }
    .servicios-container {
      gap: 24px;
    }
    .section-title {
      font-size: 28px;
    }
    .section-subtitle {
      font-size: 14px;
      text-align: center;
      margin: 0 auto;
      max-width: 100%;
    }
    .servicio-card {
      padding: 24px;
      min-height: 260px;
    }
    .card-title {
      font-size: 17px;
    }
  }
</style>

<!-- Inicialización de Swiper -->
<script is:inline type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

  document.addEventListener("DOMContentLoaded", () => {
    const swiperServicios = new Swiper(".servicios-carousel", {
      slidesPerView: 1.15,
      spaceBetween: 16,
      grabCursor: true,
      loop: true,
      speed: 1500, /* Transición suave y lenta */
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      breakpoints: {
        768: {
          slidesPerView: 2 /* 2-column catalog en tablet */,
          spaceBetween: 24,
        },
        1200: {
          slidesPerView: 4 /* 4-column catalog en desktop */,
          spaceBetween: 24,
        },
      },
    });
  });
</script>
