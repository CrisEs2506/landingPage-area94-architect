---

---

<section class="contacto-section" id="contacto">
  <div class="contacto-wrapper">
    <div class="contacto-content">
      <h2 class="section-title">Contáctanos</h2>

      <div class="contacto-grid">
        <!-- Columna Izquierda: Formulario -->
        <div class="contacto-form-col">
          <form class="contacto-form" id="contacto-form" novalidate>
            <div class="form-group">
              <input
                type="text"
                id="contacto-nombre"
                name="nombre"
                placeholder="Nombre"
                required
                autocomplete="name"
              />
            </div>

            <div class="form-row">
              <div class="form-group">
                <input
                  type="email"
                  id="contacto-correo"
                  name="correo"
                  placeholder="Email"
                  required
                  autocomplete="email"
                />
              </div>
              <div class="form-group">
                <input
                  type="tel"
                  id="contacto-telefono"
                  name="telefono"
                  placeholder="Teléfono"
                  autocomplete="tel"
                />
              </div>
            </div>

            <div class="form-group">
              <textarea
                id="contacto-mensaje"
                name="mensaje"
                placeholder="Mensaje"
                rows="4"
                required></textarea>
            </div>

            <button type="submit" class="submit-btn" id="contacto-submit">
              Enviar Mensaje
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="btn-icon"
              >
                <line x1="7" y1="7" x2="17" y2="17"></line>
                <polyline points="17 7 17 17 7 17"></polyline>
              </svg>
            </button>
          </form>
        </div>

        <!-- Columna Derecha: Información de contacto -->
        <div class="contacto-info-col">
          <!-- Teléfono -->
          <div class="info-block">
            <div class="info-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
            </div>
            <div class="info-text">
              <span class="info-value-large">300 355 43 66</span>
            </div>
          </div>

          <!-- Correo -->
          <div class="info-block">
            <div class="info-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="info-text">
              <a href="mailto:contacto@area-94.com" class="info-link"
                >contacto@area-94.com</a
              >
              <a href="mailto:proyectos@area-94.com" class="info-link"
                >proyectos@area-94.com</a
              >
            </div>
          </div>

          <!-- Dirección -->
          <div class="info-block">
            <div class="info-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="info-text">
              <span class="info-value">Cra 6 # 4 – 34</span>
              <span class="info-sub">Bogotá, Colombia</span>
            </div>
          </div>

          <!-- Redes Sociales -->
          <div class="info-block socials-block">
            <div class="socials-row">
              <!-- Instagram -->
              <a
                href="https://www.instagram.com/area.94col/"
                target="_blank"
                rel="noopener noreferrer"
                class="social-icon-link"
                aria-label="Instagram"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>

              <!-- Facebook (sin enlace aún) -->
              <a href="#" class="social-icon-link" aria-label="Facebook">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                  ></path>
                </svg>
              </a>

              <!-- TikTok (sin enlace aún) -->
              <a href="#" class="social-icon-link" aria-label="TikTok">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contacto-section {
    padding: 28px;
    background-color: var(--bg);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .contacto-wrapper {
    width: 100%;
    max-width: 1600px;
    display: flex;
    justify-content: center;
  }

  .contacto-content {
    background-color: var(--primary);
    border-radius: 4px;
    padding: 80px 48px;
    color: var(--accent);
    width: 100%;
  }

  .section-title {
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 40px 0;
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  /* Grid de dos columnas: formulario | info */
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding-left: 100px;
  }

  /* ── Formulario ── */
  .contacto-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    width: 100%;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .contacto-form input,
  .contacto-form textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: var(--accent);
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 400;
    padding: 18px 20px;
    outline: none;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .contacto-form input::placeholder,
  .contacto-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.7);
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
  }

  .contacto-form input:focus,
  .contacto-form textarea:focus {
    border-color: rgba(255, 255, 255, 0.45);
    background-color: rgba(255, 255, 255, 0.03);
  }

  .contacto-form textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    margin-top: 16px;
    background-color: #c9a96e;
    color: var(--primary);
    border: none;
    border-radius: 100px;
    padding: 16px 40px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: "Montserrat", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    width: 100%;
  }

  .submit-btn:hover {
    background-color: #d4b87d;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201, 169, 110, 0.25);
  }

  .submit-btn .btn-icon {
    width: 16px;
    height: 16px;
    opacity: 0.8;
    transition: transform 0.3s;
  }

  .submit-btn:hover .btn-icon {
    transform: translateX(4px) translateY(4px);
  }

  /* ── Información de contacto ── */
  .contacto-info-col {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 8px;
  }

  .info-block {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .info-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: center;
    align-items: center;
    color: #c9a96e;
    transition: background 0.3s ease;
  }

  .info-block:hover .info-icon {
    background: rgba(201, 169, 110, 0.15);
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-value-large {
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.2;
    letter-spacing: -0.3px;
  }

  .info-value {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    line-height: 1.4;
  }

  .info-sub {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 400;
  }

  .info-link {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 400;
    transition: color 0.3s ease;
    line-height: 1.4;
  }

  .info-link:hover {
    color: #c9a96e;
  }

  /* ── Redes Sociales ── */
  .socials-block {
    padding-top: 8px;
  }

  .socials-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .social-icon-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: center;
    align-items: center;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-icon-link:hover {
    color: #c9a96e;
    border-color: #c9a96e;
    background: rgba(201, 169, 110, 0.08);
    transform: translateY(-2px);
  }

  .social-disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  /* ── Responsive: Tablet ── */
  @media (max-width: 1199px) {
    .contacto-section {
      padding: 16px;
    }

    .contacto-content {
      border-radius: 3px;
      padding: 56px 32px;
    }

    .info-value-large {
      font-size: 24px;
    }

    .contacto-grid {
      padding-left: 75px;
    }
  }

  /* ── Responsive: Mobile ── */
  @media (max-width: 767px) {
    .contacto-section {
      padding: 0;
    }

    .contacto-wrapper {
      padding: 16px;
    }

    .contacto-content {
      border-radius: 2px;
      padding: 40px 24px;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 24px;
    }

    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-left: 0;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .info-value-large {
      font-size: 22px;
    }

    .submit-btn {
      padding: 14px 24px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contacto-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contacto-submit') as HTMLButtonElement | null;
    if (!form || !submitBtn) return;

    const originalBtnHTML = submitBtn.innerHTML;

    // ── Toast notification ──
    function showToast(message: string, type: 'success' | 'error') {
      // Remove previous toast if any
      const existing = document.getElementById('contacto-toast');
      if (existing) existing.remove();

      const toast = document.createElement('div');
      toast.id = 'contacto-toast';
      toast.setAttribute('role', 'alert');
      toast.style.cssText = `
        position: fixed;
        bottom: 32px;
        right: 32px;
        z-index: 10000;
        padding: 18px 28px;
        border-radius: 8px;
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        max-width: 420px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.35s ease, transform 0.35s ease;
        display: flex;
        align-items: center;
        gap: 12px;
        background: ${type === 'success' ? '#1a7a3a' : '#c0392b'};
      `;

      const icon = type === 'success'
        ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
        : `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;

      toast.innerHTML = `${icon}<span>${message}</span>`;
      document.body.appendChild(toast);

      // Trigger animation
      requestAnimationFrame(() => {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
      });

      // Auto dismiss
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(20px)';
        setTimeout(() => toast.remove(), 400);
      }, 5000);
    }

    // ── Validation ──
    function validateForm(): boolean {
      const nombre = (document.getElementById('contacto-nombre') as HTMLInputElement).value.trim();
      const correo = (document.getElementById('contacto-correo') as HTMLInputElement).value.trim();
      const mensaje = (document.getElementById('contacto-mensaje') as HTMLTextAreaElement).value.trim();

      if (!nombre) {
        showToast('Por favor ingresa tu nombre.', 'error');
        (document.getElementById('contacto-nombre') as HTMLInputElement).focus();
        return false;
      }
      if (!correo) {
        showToast('Por favor ingresa tu correo electrónico.', 'error');
        (document.getElementById('contacto-correo') as HTMLInputElement).focus();
        return false;
      }
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(correo)) {
        showToast('El formato de correo no es válido.', 'error');
        (document.getElementById('contacto-correo') as HTMLInputElement).focus();
        return false;
      }
      if (!mensaje) {
        showToast('Por favor escribe un mensaje.', 'error');
        (document.getElementById('contacto-mensaje') as HTMLTextAreaElement).focus();
        return false;
      }
      return true;
    }

    // ── Submit handler ──
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateForm()) return;

      // Set loading state
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="spin-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
        </svg>
        Enviando...
      `;

      const data = {
        nombre: (document.getElementById('contacto-nombre') as HTMLInputElement).value,
        correo: (document.getElementById('contacto-correo') as HTMLInputElement).value,
        telefono: (document.getElementById('contacto-telefono') as HTMLInputElement).value,
        mensaje: (document.getElementById('contacto-mensaje') as HTMLTextAreaElement).value,
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showToast('¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.', 'success');
          form.reset();
        } else {
          showToast(result.error || 'Error al enviar el mensaje. Inténtalo de nuevo.', 'error');
        }
      } catch {
        showToast('Error de conexión. Por favor inténtalo más tarde.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHTML;
      }
    });
  });
</script>

<style is:global>
  @keyframes contacto-spin {
    to { transform: rotate(360deg); }
  }
  .spin-icon {
    animation: contacto-spin 0.8s linear infinite;
  }
  #contacto-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }
</style>
