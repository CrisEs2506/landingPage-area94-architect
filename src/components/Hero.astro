---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logoImg from "../assets/Logo.png";
import homeInicialImg from "../assets/HomeInicial.png";
---

<section class="hero-wrapper">
  <div class="hero-container">
    <!-- Left Column: Content -->
    <div class="hero-content">
      <header class="header">
        <div class="logo">
          <Image src={logoImg} alt="Logo A94" />
        </div>
        <nav class="nav">
          <a href="#nosotros">Nosotros</a>
          <a href="#servicios">Servicios</a>
          <a href="#estudios">Estudios inmobiliarios</a>
          <a href="#reparaciones">Reparaciones locativas</a>
        </nav>
      </header>

      <main class="main-text">
        <h1 class="title">Ideas que Diseñan, Proyectos que se Construyen</h1>
        <p class="subtitle">
          En Área 94 ofrecemos un enfoque integral que combina diseño, técnica y
          gestión normativa para materializar proyectos sólidos y bien
          estructurados. Nuestro portafolio de servicios está diseñado para
          acompañarte en cada etapa del proceso, con soluciones a la medida de
          tus necesidades.
        </p>

        <div class="cta-group">
          <a href="#proyectos" class="primary-btn">
            Nuestros proyectos
            <!-- Down-right arrow icon -->
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="btn-icon"
            >
              <line x1="7" y1="7" x2="17" y2="17"></line>
              <polyline points="17 7 17 17 7 17"></polyline>
            </svg>
          </a>

          <a href="#venta-arriendo" class="primary-btn">
            Proyectos en venta o arriendo
            <!-- Home/Building icon -->
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="btn-icon btn-icon-up"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </main>

      <!-- Carrusel de servicios encapsulado con Swiper -->
      <div class="swiper stats-carousel">
        <div class="swiper-wrapper stats-row">
          <div class="swiper-slide">
            <div class="stat-card">
              <div class="stat-avatar" aria-label="Arquitectura">
                <Icon name="lucide:pencil-ruler" width={16} height={16} />
              </div>
              <div class="stat-desc">
                <strong>Arquitectura</strong><br />Estructuramos proyectos con
                visión técnica y financiera para maximizar tu inversión.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <div class="stat-avatar" aria-label="Urbanismo">
                <Icon name="lucide:map" width={16} height={16} />
              </div>
              <div class="stat-desc">
                <strong>Urbanismo</strong><br />Analizamos títulos, normas y
                riesgos legales para que inviertas con seguridad y viabilidad.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <div class="stat-avatar" aria-label="Diseño">
                <Icon name="lucide:pen-tool" width={16} height={16} />
              </div>
              <div class="stat-desc">
                <strong>Diseño</strong><br />Diseñamos espacios que aumentan el
                valor comercial, el atractivo y la rentabilidad del proyecto.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <div class="stat-avatar" aria-label="Construcción">
                <Icon name="lucide:hard-hat" width={16} height={16} />
              </div>
              <div class="stat-desc">
                <strong>Construcción</strong><br />Ejecutamos adecuaciones y
                reparaciones que valorizan el inmueble y mejoran su retorno.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="hero-image-side">
      <Image
        src={homeInicialImg}
        alt="Arquitectura minimalista y moderna"
        class="hero-img"
      />

      <div class="floating-controls">
        <a href="#contacto" class="pill-btn">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path></svg
          >
          Contáctanos
        </a>
        <a
          href="https://api.whatsapp.com/send/?phone=573003554366&text=Hola+Om%C3%A1r.+Busco+asesor%C3%ADa+en+arquitectura+para+estructurar+correctamente+mi+proyecto.+%C2%BFAgendamos+una+llamada%3F&type=phone_number&app_absent=0"
          target="_blank"
          rel="noopener noreferrer"
          class="pill-btn whatsapp-btn"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
          +57 300 355 4366
        </a>
        <a
          href="http://link.mercadopago.com.co/area94"
          target="_blank"
          rel="noopener noreferrer"
          class="pill-btn pagos-btn"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
          Pagos
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  :root {
    --primary: #23272f;
    --secondary: #6b6f76;
    --accent: #ffffff;
    --bg: #ffffff; /* Fondo global blanco */
    --surface-gray: #e9eaed; /* Gris un poco más oscuro para que resalten más las celdas blancas */
  }

  body {
    margin: 0;
    padding: 0;
    font-family: "Montserrat", sans-serif;
    color: var(--primary);
    background-color: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * {
    box-sizing: border-box;
  }
</style>

<style>
  .hero-wrapper {
    padding: 12px;
    /*min-height: 100vh; Permite crecer más de la pantalla si hay contenido */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 32px;
    width: 100%;
    max-width: 1600px;
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    padding: 32px 40px 40px; /* Ajustado a 32px para igualar el top de .floating-controls */
    position: relative;
    background-color: var(--surface-gray);
    border-radius: 40px;
    min-width: 0; /* Crucial para evitar que elementos hijos como Swiper rompan el grid */
  }

  .header,
  .main-text,
  .stats-row {
    position: relative;
    z-index: 1;
  }

  .header {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    gap: 30px; /* Mayor separación entre el logo y los nav */
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 50px;
    width: auto;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a {
    text-decoration: none;
    font-size: 13px;
    color: var(--secondary);
    font-weight: 500;
    transition: color 0.3s;
    width: min-content; /* Fuerza a que la caja mida solo lo de su palabra más larga */
  }

  .nav a:hover {
    color: var(--primary);
  }

  .main-text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-right: 0px;
    margin: 30px 0;
    margin-bottom: 20px;
  }

  .title {
    font-size: clamp(20px, 2.2vw, 28px); /* Escala reducida */
    line-height: 1.15;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
    letter-spacing: -1px;
    max-width: 100%;
  }

  .subtitle {
    font-size: 13px;
    line-height: 1.5;
    color: var(--secondary);
    margin-top: 16px;
    font-weight: 500;
    max-width: 100%;
  }

  .cta-group {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 5px;
  }

  .primary-btn {
    background-color: var(--primary);
    color: var(--accent);
    border: 1px solid transparent;
    border-radius: 100px;
    padding: 10px 19px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .primary-btn:hover {
    background-color: #3b414d;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(35, 39, 47, 0.15);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
    opacity: 0.8;
    transition: transform 0.3s;
  }

  .primary-btn:hover .btn-icon {
    transform: translateX(4px) translateY(4px);
  }

  .primary-btn:hover .btn-icon.btn-icon-up {
    transform: translateX(4px) translateY(-4px);
  }

  .stats-carousel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    padding-top: 20px; /* Espacio superior para que los avatares superpuestos no se corten */
  }

  .stats-row {
    display: flex;
    /* Comportamiento natural sobreescrito por Swiper, pero se pone para soporte */
  }

  /* Ajustes para que la tarjeta use la altura del slide si queremos */
  .swiper-slide {
    display: flex;
    height: auto;
  }

  .stat-card {
    flex: 1;
    background-color: #ffffff;
    border-radius: 24px;
    padding: 32px 16px 20px; /* Un poco más de padding vertical para dar aire extra */
    min-height: 140px; /* Aumenta y fuerza una altura mínima */
    position: relative; /* Necesario para anclar el avatar flotante */
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* Alinea los textos al inicio (arriba) */
    width: auto;
    max-width: 100%;
    margin-right: 0; /* Lo maneja Swiper con spaceBetween */
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.06);
  }

  .stat-avatar {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    color: var(--primary);
    display: flex;
    justify-content: center;
    align-items: center;
    border: 3px solid var(--surface-gray);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .stat-avatar svg {
    margin: 0;
    padding: 0;
    display: block;
    width: 18px;
    height: 18px;
  }

  .stat-desc {
    font-size: 13px; /* Recuperando un poco la legibilidad */
    line-height: 1.5;
    color: var(--secondary);
    font-weight: 400;
  }

  .stat-desc strong {
    font-size: 15px; /* Título descriptivo fuerte */
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 8px;
    display: inline-block;
  }

  /* Right Column */
  .hero-image-side {
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    height: 100%; /* Forzamos a que tome el 100% que le toque en la grid, sin forzar min-height */
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  .hero-image-side:hover .hero-img {
    transform: scale(1.02);
  }

  .floating-controls {
    position: absolute;
    top: 32px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: flex-start;
    gap: 16px;
  }

  .pill-btn {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: var(--primary);
    border-radius: 100px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    text-decoration: none;
  }

  .pill-btn:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .whatsapp-btn:hover {
    background-color: #25d366 !important;
    color: #ffffff !important;
    border-color: #25d366 !important;
  }

  .pagos-btn:hover {
    background-color: #009ee3 !important;
    color: #ffffff !important;
    border-color: #009ee3 !important;
  }

  .pill-btn svg {
    color: var(--secondary);
    transition: color 0.3s;
  }

  .whatsapp-btn:hover svg,
  .pagos-btn:hover svg {
    color: #ffffff !important;
  }

  /* Responsive Design */
  @media (max-width: 1199px) {
    /* Tablet */
    .hero-wrapper {
      height: auto;
      min-height: 100vh; /* En tablet para abajo volvemos a dejar que fluya, ya que se apila verticalmente */
      padding: 16px;

      overflow: visible;
    }
    .hero-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .hero-content {
      padding: 32px 24px;
      border-radius: 24px;
    }
    .main-text {
      padding-right: 0;
      margin: 30px 0;
      margin-bottom: 25px;
    }
    .title {
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.1;
    }
    .subtitle {
      font-size: 16px;
      max-width: 100%;
    }

    .hero-image-side {
      height: 470px; /* Reducido de 600px a 480px para que no abarque tanto espacio vertical en tablet */
      min-height: auto;
      border-radius: 24px;
    }
    .header {
      gap: 32px;
    }
  }

  @media (max-width: 767px) {
    /* Mobile */
    .hero-wrapper {
      padding: 0;
    }
    .hero-container {
      gap: 24px;
      padding: 16px;
    }
    .title {
      font-size: 28px;
    }
    .subtitle {
      font-size: 14px;
    }
    .header {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 24px;
    }
    .nav {
      flex-wrap: wrap;
      gap: 16px;
      display: flex; /* Se muestra para >= 500px */
    }
    .stats-carousel {
      /* Paginación eliminada */
    }
    .hero-image-side {
      height: 480px;
      border-radius: 24px;
    }
    .floating-controls {
      top: 16px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      align-items: flex-start;
    }
    .pill-btn {
      justify-content: flex-start;
    }
    .cta-group {
      justify-content: flex-start;
    }
  }

  /* Ocultamos debajo de los 500px explícitamente */
  @media (max-width: 499px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
    }
    .nav {
      display: none;
    }
  }
</style>

<!-- Importación de CSS de Swiper -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<!-- Inicialización de Swiper -->
<script is:inline type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

  document.addEventListener("DOMContentLoaded", () => {
    const swiper = new Swiper(".stats-carousel", {
      slidesPerView: 1.2 /* Cuantos ver a la vez en mobile */,
      spaceBetween: 16,
      grabCursor: true,
      loop: true,
      speed: 1500 /* Transición suave y lenta */,
      autoplay: {
        delay: 3000 /* Tiempo entre cada movimiento automático */,
        disableOnInteraction: false,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3 /* Exáctamente 3 tarjetas visibles */,
        },
      },
    });
  });
</script>
