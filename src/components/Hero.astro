---
import { Image } from "astro:assets";
import logoImg from "../assets/Logo.png";
---

<section class="hero-wrapper">
  <div class="hero-container">
    <!-- Left Column: Content -->
    <div class="hero-content">
      <header class="header">
        <div class="logo">
          <Image src={logoImg} alt="Carcas House Logo" />
        </div>
        <nav class="nav">
          <a href="#nosotros">Nosotros</a>
          <a href="#servicios">Servicios</a>
          <a href="http://link.mercadopago.com.co/area94" target="_blank" rel="noopener noreferrer">Pagos</a>
        </nav>
      </header>

      <main class="main-text">
        <h1 class="title">
          Ideas que Diseñan, <br /> Proyectos que se Construyen
        </h1>
        <p class="subtitle">
          Integramos arquitectura, planificación urbana y análisis jurídico para
          acompañar tu proyecto desde la idea inicial hasta su ejecución.
        </p>

        <a href="#proyectos" class="primary-btn">
          Nuestros proyectos
          <!-- Down-right arrow icon -->
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="btn-icon"
          >
            <line x1="7" y1="7" x2="17" y2="17"></line>
            <polyline points="17 7 17 17 7 17"></polyline>
          </svg>
        </a>
      </main>

      <!-- Carrusel de servicios encapsulado con Swiper -->
      <div class="swiper stats-carousel">
        <div class="swiper-wrapper stats-row">
          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Planificación"
              />
              <div class="stat-desc">
                <strong>Planificación Arquitectónica</strong><br />Diseñamos
                proyectos eficientes adaptados a cada necesidad.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Licenciamiento"
              />
              <div class="stat-desc">
                <strong>Licenciamiento Urbanístico</strong><br />Gestionamos
                licencias y trámites para tu proyecto.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Construcción"
              />
              <div class="stat-desc">
                <strong>Construcción y Ejecución</strong><br />Desarrollamos
                obras con calidad y cumplimiento.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Reglamentos"
              />
              <div class="stat-desc">
                <strong>Reglamentos de P.H.</strong><br />Redactamos y
                actualizamos reglamentos para copropiedades.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1517581177682-a085bb7ffb15?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Planos"
              />
              <div class="stat-desc">
                <strong>Planos de P.H.</strong><br />Elaboramos y actualizamos
                planos para tus inmuebles.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Subdivisión"
              />
              <div class="stat-desc">
                <strong>Subdivisión Predial</strong><br />Gestionamos divisiones
                y legalización de predios.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1518780664697-55e3ad937233?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Estudios"
              />
              <div class="stat-desc">
                <strong>Estudios Inmobiliarios</strong><br />Analizamos
                viabilidad legal y normativa de proyectos.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1486325212027-8081e485255e?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Urbanizaciones"
              />
              <div class="stat-desc">
                <strong>Licencias para Urbanizaciones</strong><br />Tramitamos
                permisos para desarrollos y parcelaciones.
              </div>
            </div>
          </div>

          <div class="swiper-slide">
            <div class="stat-card">
              <img
                src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?q=80&w=100&auto=format&fit=crop"
                class="stat-avatar"
                alt="Gestión"
              />
              <div class="stat-desc">
                <strong>Gestión Jurídica de Proyectos</strong><br
                />Acompañamiento legal durante todo el desarrollo.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="hero-image-side">
      <img
        src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?q=80&w=1500&auto=format&fit=crop"
        alt="Arquitectura minimalista y moderna"
        class="hero-img"
      />

      <div class="floating-controls">
        <a href="#contacto" class="pill-btn">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path></svg
          >
          Contactanos
        </a>
        <a href="https://api.whatsapp.com/send/?phone=573003554366&text=Hola+Om%C3%A1r.+Busco+asesor%C3%ADa+en+arquitectura+para+estructurar+correctamente+mi+proyecto.+%C2%BFAgendamos+una+llamada%3F&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer" class="pill-btn whatsapp-btn">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
          +57 300 355 4366
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  :root {
    --primary: #23272f;
    --secondary: #6b6f76;
    --accent: #ffffff;
    --bg: #ffffff; /* Fondo global blanco */
    --surface-gray: #e9eaed; /* Gris un poco más oscuro para que resalten más las celdas blancas */
  }

  body {
    margin: 0;
    padding: 0;
    font-family: "Montserrat", sans-serif;
    color: var(--primary);
    background-color: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * {
    box-sizing: border-box;
  }
</style>

<style>
  .hero-wrapper {
    padding: 18px;
    /*min-height: 100vh; Permite crecer más de la pantalla si hay contenido */
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 32px;
    width: 100%;
    max-width: 1600px;
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    padding: 32px 40px 40px; /* Ajustado a 32px para igualar el top de .floating-controls */
    position: relative;
    background-color: var(--surface-gray);
    border-radius: 40px;
    min-width: 0; /* Crucial para evitar que elementos hijos como Swiper rompan el grid */
  }

  .header,
  .main-text,
  .stats-row {
    position: relative;
    z-index: 1;
  }

  .header {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    gap: 64px; /* Mayor separación entre el logo y los nav */
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 36px;
    width: auto;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav a {
    text-decoration: none;
    font-size: 13px;
    color: var(--secondary);
    font-weight: 500;
    transition: color 0.3s;
  }

  .nav a:hover {
    color: var(--primary);
  }

  .main-text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-right: 0px;
    margin: 40px 0;
  }

  .title {
    font-size: clamp(24px, 2.8vw, 34px); /* Escala reducida aún más */
    line-height: 1.15;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
    letter-spacing: -1px;
    max-width: 100%;
  }

  .subtitle {
    font-size: 13px;
    line-height: 1.5;
    color: var(--secondary);
    margin-top: 16px;
    font-weight: 500;
    max-width: 85%;
  }

  .primary-btn {
    margin-top: 20px;
    background-color: var(--primary);
    color: var(--accent);
    border: none;
    border-radius: 100px;
    padding: 14px 36px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: inherit;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .primary-btn:hover {
    background-color: #3b414d;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(35, 39, 47, 0.15);
  }

  .btn-icon {
    width: 16px;
    height: 16px;
    opacity: 0.8;
    transition: transform 0.3s;
  }

  .primary-btn:hover .btn-icon {
    transform: translateX(4px) translateY(4px);
  }

  .stats-carousel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    padding-top: 20px; /* Espacio superior para que los avatares superpuestos no se corten */
  }

  .stats-row {
    display: flex;
    /* Comportamiento natural sobreescrito por Swiper, pero se pone para soporte */
  }

  /* Ajustes para que la tarjeta use la altura del slide si queremos */
  .swiper-slide {
    display: flex;
    height: auto;
  }

  .stat-card {
    flex: 1;
    background-color: #ffffff;
    border-radius: 24px;
    padding: 32px 16px 20px; /* Aumentado padding-top para acomodar el avatar */
    position: relative; /* Necesario para anclar el avatar flotante */
    display: flex;
    flex-direction: column;
    width: auto;
    max-width: 100%;
    margin-right: 0; /* Lo maneja Swiper con spaceBetween */
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.06);
  }

  .stat-avatar {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ffffff; /* Borde blanco para el marcado contraste con el grid de atrás */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .stat-desc {
    font-size: 13px; /* Recuperando un poco la legibilidad */
    line-height: 1.5;
    color: var(--secondary);
    font-weight: 400;
  }

  .stat-desc strong {
    font-size: 15px; /* Título descriptivo fuerte */
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 8px;
    display: inline-block;
  }

  /* Right Column */
  .hero-image-side {
    position: relative;
    border-radius: 40px;
    overflow: hidden;
    height: 100%; /* Forzamos a que tome el 100% que le toque en la grid, sin forzar min-height */
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  .hero-image-side:hover .hero-img {
    transform: scale(1.02);
  }

  .floating-controls {
    position: absolute;
    top: 32px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: flex-start;
    gap: 16px;
  }

  .pill-btn {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: var(--primary);
    border-radius: 100px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    text-decoration: none;
  }

  .pill-btn:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .whatsapp-btn:hover {
    background-color: #25d366 !important;
    color: #ffffff !important;
    border-color: #25d366 !important;
  }

  .pill-btn svg {
    color: var(--secondary);
    transition: color 0.3s;
  }

  .whatsapp-btn:hover svg {
    color: #ffffff !important;
  }

  /* Responsive Design */
  @media (max-width: 1199px) {
    /* Tablet */
    .hero-wrapper {
      height: auto;
      min-height: 100vh; /* En tablet para abajo volvemos a dejar que fluya, ya que se apila verticalmente */
      padding: 16px;
      overflow: visible;
    }
    .hero-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .hero-content {
      padding: 32px 24px;
      border-radius: 24px;
    }
    .main-text {
      padding-right: 0;
      margin: 40px 0;
    }
    .title {
      font-size: clamp(38px, 5vw, 54px);
      line-height: 1.1;
    }
    .subtitle {
      font-size: 16px;
      max-width: 100%;
    }
    .primary-btn {
      width: 100%;
      justify-content: center;
      padding: 16px 24px;
      font-size: 16px;
    }
    .hero-image-side {
      height: 600px;
      min-height: auto;
      border-radius: 24px;
    }
    .header {
      gap: 32px;
    }
  }

  @media (max-width: 767px) {
    /* Mobile */
    .hero-wrapper {
      padding: 0;
    }
    .hero-container {
      gap: 24px;
      padding: 16px;
    }
    .title {
      font-size: 32px;
    }
    .subtitle {
      font-size: 14px;
    }
    .header {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 24px;
    }
    .nav {
      flex-wrap: wrap;
      gap: 16px;
      display: flex; /* Se muestra para >= 500px */
    }
    .stats-carousel {
      /* Paginación eliminada */
    }
    .hero-image-side {
      height: 480px;
      border-radius: 24px;
    }
    .floating-controls {
      top: 16px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      align-items: stretch;
    }
    .pill-btn {
      justify-content: center;
    }
    .primary-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Ocultamos debajo de los 500px explícitamente */
  @media (max-width: 499px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
    }
    .nav {
      display: none;
    }
  }
</style>

<!-- Importación de CSS de Swiper -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<!-- Inicialización de Swiper -->
<script is:inline type="module">
  import Swiper from "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.mjs";

  document.addEventListener("DOMContentLoaded", () => {
    const swiper = new Swiper(".stats-carousel", {
      slidesPerView: 1.2 /* Cuantos ver a la vez en mobile */,
      spaceBetween: 16,
      grabCursor: true,
      loop: true,
      speed: 1500, /* Transición suave y lenta */
      autoplay: {
        delay: 3000, /* Tiempo entre cada movimiento automático */
        disableOnInteraction: false,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3 /* Exáctamente 3 tarjetas visibles */,
        },
      },
    });
  });
</script>
